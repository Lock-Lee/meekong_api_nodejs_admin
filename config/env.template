# Meekong API - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/meekong_api

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Secret (use a strong, random string in production)
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing rounds (12 recommended for production)
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 Configuration for file uploads
AWS_S3_BUCKET=meekong-uploads-bucket
AWS_S3_REGION=ap-southeast-1

# ============================================================================
# File Upload Configuration
# ============================================================================
# Local upload path (relative to application root)
UPLOAD_PATH=./public/images

# Maximum file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================
# Redis URL for caching and sessions
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# SMTP Configuration for email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email templates
EMAIL_FROM=noreply@meekong.com
EMAIL_FROM_NAME=Meekong Platform

# ============================================================================
# Payment Gateway Configuration (Optional)
# ============================================================================
# Omise Configuration (Thailand payment gateway)
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxxxxxx
OMISE_WEBHOOK_SECRET=whsk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Shipping Configuration (Optional)
# ============================================================================
# Shippop Configuration (Thailand shipping service)
SHIPPOP_API_KEY=your_shippop_api_key
SHIPPOP_WEBHOOK_SECRET=your_shippop_webhook_secret
SHIPPOP_ENVIRONMENT=test

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file configuration
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================
# Sentry for error tracking
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# New Relic APM
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=Meekong API

# ============================================================================
# External API Configuration (Optional)
# ============================================================================
# Social Media Login
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# API rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=60

# ============================================================================
# Session Configuration
# ============================================================================
# Session secret for cookie signing
SESSION_SECRET=your-session-secret-key-here

# Session store configuration
SESSION_STORE=redis
SESSION_MAX_AGE=86400000

# ============================================================================
# Development Tools (Development Only)
# ============================================================================
# Debug mode
DEBUG=meekong:*

# Development database (if different from production)
DEV_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/meekong_dev

# Test database
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/meekong_test

# ============================================================================
# Performance Configuration
# ============================================================================
# Node.js memory limits
NODE_OPTIONS=--max-old-space-size=512

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Request timeout
REQUEST_TIMEOUT=30000

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
# Enable/disable features
FEATURE_AUCTION_ENABLED=true
FEATURE_RFQ_ENABLED=true
FEATURE_CHAT_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=true

# ============================================================================
# Backup Configuration (Optional)
# ============================================================================
# S3 backup configuration
BACKUP_S3_BUCKET=meekong-backups
BACKUP_RETENTION_DAYS=30

# Database backup
DB_BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================
# Slack webhook for system notifications
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Push notification service
FCM_SERVER_KEY=your_fcm_server_key
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
