{
  "name": "meekong-api",
  "version": "1.0.0",
  "description": "Meekong API Server",
  "main": "dist/main/server.js",
  "_moduleAliases": {
    "@api": "dist/api",
    "@config": "dist/shared/config",
    "@middlewares": "dist/api/middlewares",
    "@controllers": "dist/api/controllers",
    "@routes": "dist/api/routes",
    "@utils": "dist/shared/utils",
    "@schemas": "dist/api/schemas",
    "@business": "dist/business",
    "@data": "dist/data",
    "@shared": "dist/shared"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "tsc-alias",
    "start": "node dist/main/server.js",
    "start:workers": "node dist/workers/media.worker.js",
    "dev": "nodemon --watch src --ext ts,js,json --exec \"node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main/server.ts\"",
    "dev:workers": "nodemon --exec ts-node src/workers/media.worker.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:infrastructure": "node scripts/test-infrastructure.js",
    "test:api": "node scripts/test-api-endpoints.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "ts-node prisma/base.seed.ts",
    "prisma:studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "api",
    "marketplace"
  ],
  "author": "Meekong Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@prisma/client": "^6.16.0",
    "@types/express-fileupload": "^1.5.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/morgan": "^1.9.10",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.12.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.13.2",
    "cjs-loader": "^0.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.4.0",
    "ffprobe-static": "^3.1.0",
    "firebase-admin": "^13.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "inversify": "^6.0.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "omise": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^6.16.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapping": {
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@business/(.*)$": "<rootDir>/src/business/$1",
      "^@api/(.*)$": "<rootDir>/src/api/$1",
      "^@data/(.*)$": "<rootDir>/src/data/$1",
      "^@main/(.*)$": "<rootDir>/src/main/$1",
      "^@config/(.*)$": "<rootDir>/src/shared/config/$1",
      "^@middlewares/(.*)$": "<rootDir>/src/api/middlewares/$1",
      "^@controllers/(.*)$": "<rootDir>/src/api/controllers/$1",
      "^@routes/(.*)$": "<rootDir>/src/api/routes/$1",
      "^@utils/(.*)$": "<rootDir>/src/shared/utils/$1",
      "^@schemas/(.*)$": "<rootDir>/src/api/schemas/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/workers/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000,
    "typeRoots": [
      "<rootDir>/tests/types",
      "<rootDir>/node_modules/@types"
    ]
  }
}
