# Meekong API Environment Configuration
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/meekong?schema=public

# Authentication
JWT_SECRET=your-super-secret-jwt-key-256-bits-minimum
JWT_EXPIRES_IN=7d

# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_ACCOUNT_ID=your-aws-account-id
S3_BUCKET=your-s3-bucket
AWS_S3_BUCKET=your-s3-bucket

# Redis (for workers)  
REDIS_URL=redis://localhost:6379
ENABLE_WORKERS=false

# CI/CD Variables (for deployment)
PRODUCTION_URL=https://your-domain.com
EC2_HOST=your-ec2-ip
EC2_USER=ubuntu
# EC2_SSH_KEY=your-private-key (set in GitHub secrets)

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_PATH=/app/public/images

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=https://your-domain.com

# Optional
SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook
OMISE_SECRET_KEY=your-omise-secret
OMISE_PUBLIC_KEY=your-omise-public
