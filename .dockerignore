# Meekong API - Docker Ignore Configuration
# Optimize Docker build by excluding unnecessary files

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Development files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output (will be created during build stage)
dist
.tsbuildinfo

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git
.gitignore
.github

# Documentation and README files
README.md
docs/
*.md

# Test files
coverage/
.nyc_output
test/
tests/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
.npm
.eslintcache

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Local development
.env.development
.env.test

# SSL certificates (will be mounted or configured separately)
ssl/

# Temporary folders
tmp/
temp/

# Infrastructure and scripts (not needed in container)
infrastructure/
scripts/
config/

# Backup files
backup/
*.backup

# Generated documentation
generated/docs
