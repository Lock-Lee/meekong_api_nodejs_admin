// ----
// Return/Refund System
// ----

// Return Request - ใช้งานได้กับ Order, Auction, Satisfy, RFQOrder
model ReturnRequest {
  id String @id @default(uuid())

  // Transaction Relations (polymorphic - only one should be filled)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  auctionId String?
  auction   Auction? @relation(fields: [auctionId], references: [id])

  satisfyId String?
  satisfy   Satisfy? @relation(fields: [satisfyId], references: [id])

  rfqOrderId String?
  rfqOrder   RFQOrder? @relation(fields: [rfqOrderId], references: [id])

  // Return Details
  requesterId String
  requester   User   @relation("ReturnRequester", fields: [requesterId], references: [id])

  reason      ReturnReason
  description String?
  images      String? // JSON array of evidence images

  // Financial
  requestedAmount Decimal @default(0.00) @db.Decimal(10, 2) // จำนวนที่ขอคืน
  approvedAmount  Decimal @default(0.00) @db.Decimal(10, 2) // จำนวนที่อนุมัติ
  shippingCost    Decimal @default(0.00) @db.Decimal(10, 2) // ค่าขนส่งคืน (ถ้ามี)

  status    ReturnStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  refunds     RefundTransaction[]
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([auctionId])
  @@index([satisfyId])
  @@index([rfqOrderId])
  @@index([requesterId])
}

// Return Items - รายการสินค้าที่ต้องการคืน
model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  variantId String?
  variant   ItemVariant? @relation(fields: [variantId], references: [id])

  quantity     Int
  unitPrice    Decimal @default(0.00) @db.Decimal(10, 2)
  returnReason String? // เหตุผลเฉพาะของ item นี้
  condition    String? // สภาพของสินค้าที่คืน

  @@index([returnRequestId])
  @@index([itemId])
}

// Refund Transaction - การคืนเงินจริง
model RefundTransaction {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])

  // Payment Integration
  chargeId String? // Original charge ที่จะ refund
  charge   Charge? @relation("OriginalCharge", fields: [chargeId], references: [id])

  refundId String? // Refund record ใน payment system
  refund   Refund? @relation("RefundTransactionDetails", fields: [refundId], references: [id])

  // Refund Details
  refundAmount Decimal @default(0.00) @db.Decimal(10, 2)
  refundReason String

  status      RefundStatus @default(PENDING)
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnRequestId])
  @@index([chargeId])
  @@index([refundId])
}

// ----
// Shipping System with Shippop Integration
// ----

// Courier Providers (Flash, Kerry, Thailand Post, etc.)
model Courier {
  id       String  @id @default(uuid())
  code     String  @unique // 'FLASH', 'KERRY', 'THP'
  name     String // 'Flash Express', 'Kerry Express'
  isActive Boolean @default(true)
  meta     Json? // additional settings

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shipping Services (Standard, Express, etc.)
model Service {
  id          String  @id @default(uuid())
  code        String // 'STANDARD', 'EXPRESS'
  name        String // 'Standard Delivery'
  courierCode String
  courier     Courier @relation(fields: [courierCode], references: [code])

  options  Json? // pickup/dropoff, insurance, cod options
  isActive Boolean @default(true)

  rateQuotes RateQuote[]
  shipments  Shipment[]

  @@unique([courierCode, code])
}

// Generic Shipment model that works with all transaction types
model Shipment {
  id String @id @default(uuid())

  // Transaction Relations (polymorphic - only one should be filled)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  auctionId String?
  auction   Auction? @relation(fields: [auctionId], references: [id])

  satisfyId String?
  satisfy   Satisfy? @relation(fields: [satisfyId], references: [id])

  rfqOrderId String?
  rfqOrder   RFQOrder? @relation(fields: [rfqOrderId], references: [id])

  // Address Relations
  senderAddressId String
  senderAddress   UserAddress @relation("SenderShipments", fields: [senderAddressId], references: [id])

  receiverAddressId String
  receiverAddress   UserAddress @relation("ReceiverShipments", fields: [receiverAddressId], references: [id])

  // Shipping Service
  courierCode String
  serviceCode String
  service     Service @relation(fields: [courierCode, serviceCode], references: [courierCode, code])

  // Shippop Integration Fields
  purchaseId String? @unique // from Booking API
  trackingNo String? @unique // from Confirm API
  labelUrl   String? // from Label API

  // Financial
  codAmount       Decimal @default(0.00) @db.Decimal(10, 2) // Cash on Delivery
  insuranceAmount Decimal @default(0.00) @db.Decimal(10, 2)
  shippingCost    Decimal @default(0.00) @db.Decimal(10, 2) // ค่าขนส่ง
  totalCost       Decimal @default(0.00) @db.Decimal(10, 2) // รวมค่าธรรมเนียมทั้งหมด
  currency        String  @default("THB")

  // Status & Timestamps
  status      ShipmentStatus @default(DRAFT)
  bookedAt    DateTime?
  confirmedAt DateTime?

  // Raw Data from Shippop
  rawBooking Json? // raw response from booking/confirm

  // Relations
  parcels        ShipmentParcel[]
  rateQuotes     RateQuote[]
  trackingEvents TrackingEvent[]
  labelFiles     LabelFile[]
  cancellation   Cancellation?

  // Payment for shipping costs
  shippingPayments ShippingPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([auctionId])
  @@index([satisfyId])
  @@index([rfqOrderId])
  @@index([purchaseId])
  @@index([trackingNo])
  @@index([status])
}

// Parcel details for shipments
model ShipmentParcel {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  weightKg    Float
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  description String?

  @@index([shipmentId])
}

// Rate quotes from different couriers
model RateQuote {
  id         String    @id @default(uuid())
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  courierCode String
  serviceCode String
  service     Service @relation(fields: [courierCode, serviceCode], references: [courierCode, code])

  price    Decimal @default(0.00) @db.Decimal(10, 2)
  currency String  @default("THB")
  etdDays  Int? // estimated delivery days

  expiresAt DateTime?
  rawRate   Json? // raw response from rate API

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([courierCode, serviceCode])
}

// Tracking events from webhooks or polling
model TrackingEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  statusCode String // normalized status
  statusText String // original status from provider
  location   String?
  eventTime  DateTime // when the event happened
  rawPayload Json? // raw tracking data

  // Webhook source
  webhookLogId String?
  webhookLog   WebhookLog? @relation(fields: [webhookLogId], references: [id])

  receivedAt DateTime @default(now())

  @@index([shipmentId])
  @@index([statusCode])
  @@index([eventTime])
}

// Label files (PDF/ZPL)
model LabelFile {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fileUrl  String? // remote URL from Shippop
  filePath String? // local file path if cached
  format   String // 'pdf', 'zpl'

  createdAt DateTime @default(now())

  @@index([shipmentId])
}

// Shipment cancellation
model Cancellation {
  id         String   @id @default(uuid())
  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  reason      String
  status      CancellationStatus @default(REQUESTED)
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Webhook logs from Shippop
model WebhookLog {
  id        String @id @default(uuid())
  eventType String // 'tracking', 'purchase', etc.
  payload   Json

  trackingEvents TrackingEvent[]

  receivedAt DateTime @default(now())

  @@index([eventType])
}

// ----
// Shipping Payment System
// ----

// Payment for shipping costs (separate from order payment)
model ShippingPayment {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  // Who pays for shipping
  payerId String
  payer   User   @relation(fields: [payerId], references: [id])

  // Payment details
  amount      Decimal             @default(0.00) @db.Decimal(10, 2)
  currency    String              @default("THB")
  paymentType ShippingPaymentType

  // Integration with main payment system
  chargeId String?
  charge   Charge? @relation(fields: [chargeId], references: [id])

  status ShippingPaymentStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([payerId])
  @@index([status])
}

model BuyerReportItem {
  id        String         @id @default(uuid())
  buyerId   String
  itemId    String
  typeId    String
  shopId    String
  reason    String
  images    String[]
  createdAt DateTime       @default(now())
  buyer     User           @relation(fields: [buyerId], references: [id])
  item      Item           @relation(fields: [itemId], references: [id])
  type      ReportItemType @relation(fields: [typeId], references: [id])
  shop      Shop           @relation(fields: [shopId], references: [id])

  @@index([buyerId])
  @@index([itemId])
  @@index([typeId])
  @@index([shopId])
}

model ReportItemType {
  id               String            @id @default(uuid())
  name             String
  buyerReportItems BuyerReportItem[]
}

